# Mongo (local default; Docker → use host.docker.internal or Atlas)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DBNAME=pace_database
# MONGODB_TLS=true

# Optional dashboard MongoDB used only by the explicit influencer export.
# DASHBOARD_DATABASE_HOST=localhost
# DASHBOARD_DATABASE_NAME=dashboard_database
# DASHBOARD_DATABASE_USERNAME=
# DASHBOARD_DATABASE_PASSWORD=

# Optional API gate
# CRAWL_API_KEY=

# Crawl
DEFAULT_FETCH_LIMIT=50
CRAWL_MAX_WORKERS=4
CRAWL_PW_REDDIT_SLOTS=1
CRAWL_TASK_TIMEOUT_SEC=10800

# Playwright sessions (DevTools → Cookies)
X_AUTH_TOKEN=
X_CT0=
# Optional alternative: raw cookie header or Playwright storage-state path.
# X_BROWSER_SESSION=
REDDIT_SESSION=
# REDDIT_TOKEN_V2=

# Source API keys (same names as Pace-Unit code/Backend/credentials/backend_example.env)
GUARDIAN_API_KEY=your_guardian_api_key_here
NEWSAPI_KEY=your_newsapi_key_here
YOUTUBE_API_KEY=your_youtube_api_key_here
REDDIT_CLIENT_ID=your_reddit_client_id_here
REDDIT_CLIENT_SECRET=your_reddit_client_secret_here
REDDIT_USER_AGENT=DataCrawlerBot/0.1 by /u/your_reddit_username_here

# OpenAI (relevance eval: python -m tests.eval_relevent)
# OPENAI_API_KEY=
# EVAL_MODEL=gpt-5.6-luna

# Optional: point config at Pace-Unit backend.env instead of duplicating keys
# (config.py auto-loads ../Pace-Unit/code/Backend/credentials/backend.env if present)

# SQS — article response queue + command queue (long-poll)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=ap-southeast-2
# AWS_SQS_QUEUE_URL=https://sqs.ap-southeast-2.amazonaws.com/622235678838/social_listening_crawling_response
# AWS_SQS_COMMAND_QUEUE_URL=https://sqs.ap-southeast-2.amazonaws.com/622235678838/social_listening_data_crawling
# SQS_WAIT_TIME_SECONDS=20
# SQS_COMMAND_CONSUMER_ENABLED=1

# Influencer discovery (DCT-owned durable workflow)
INFLUENCER_SQS_QUEUE_NAME=x-profile-jobs.fifo
# INFLUENCER_SQS_ENDPOINT_URL=http://localhost:4566
INFLUENCER_SQS_VISIBILITY_TIMEOUT_SECONDS=180
INFLUENCER_SQS_RECEIVE_BATCH_SIZE=10
INFLUENCER_SQS_RECEIVE_WAIT_TIME_SECONDS=2
INFLUENCER_SQS_IDLE_POLL_SECONDS=5
INFLUENCER_SQS_MAX_RECEIVE_COUNT=1
X_AUTHORS_PER_QUERY=20
X_MAX_SCROLLS_PER_QUERY=8
PUBLIC_CANDIDATES_PER_ARTICLE=40
MINIMUM_FOLLOWERS=10000
MINIMUM_RELEVANCE_SCORE=0.20
GOOD_HYBRID_RELEVANCE_THRESHOLD=0.60
PROFILE_REFRESH_AFTER_HOURS=24
LEADERBOARD_MAX_AGE_DAYS=30
ENABLE_SNOWBALL=false
X_WORKER_LOCK_PATH=/tmp/x-influencer-discovery.x-worker.lock
X_FETCH_LOG_DIR=logs

# Email alerts on session_expired (optional)
# ALERT_EMAIL_TO=
# ALERT_EMAIL_FROM=
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_USE_TLS=1
